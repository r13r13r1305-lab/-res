<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متجر RWS Store</title>
    <style>
        body {
            background-color: #0b0f19;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .header {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 15px 20px;
            width: 100%;
            max-width: 500px;
            text-align: center;
            margin-bottom: 20px;
            box-sizing: border-box;
        }
        .header h1 {
            font-size: 18px;
            color: #38bdf8;
            margin: 0 0 8px 0;
        }
        .header p {
            font-size: 13px;
            color: #4ade80;
            margin: 0;
        }
        .app-list {
            width: 100%;
            max-width: 500px;
        }
        .app-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            gap: 12px;
        }
        .app-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            object-fit: cover;
        }
        .app-info {
            flex-grow: 1;
        }
        .app-name {
            font-size: 15px;
            font-weight: bold;
            margin: 0 0 4px 0;
        }
        .app-desc {
            font-size: 12px;
            color: #94a3b8;
            margin: 0;
        }
        .install-btn {
            background: #38bdf8;
            color: #0b0f19;
            border: none;
            padding: 8px 14px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 12px;
            cursor: pointer;
            text-decoration: none;
        }
        .footer {
            margin-top: 30px;
            font-size: 11px;
            color: #64748b;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>🚀 + RWS Store متجر</h1>
        <p>✅ الجهاز مفعل بشهادة 2026</p>
    </div>

    <div class="app-list" id="appContainer">
        <!-- التطبيقات تظهر هنا تلقائياً -->
    </div>

    <div class="footer">
        صنع بواسطة أبو فواز / 2026 © RWS
    </div>

    <script>
        const data = {
            "apps": [
                {
                    "name": "يوتيوب بلس (مكرر)",
                    "desc": "إيقاف الإعلانات وتشغيل بالخلفية",
                    "icon": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/31/3d/26/313d26b0-7a55-2d43-52f2-f8db891fcdfb/AppIcon-0-0-1x_U007emarketing-0-7-0-sRGB-22-85-220.png/512x512bb.jpg",
                    "installUrl": "#"
                },
                {
                    "name": "تيك توك بلس",
                    "desc": "تحميل الفيديوهات بدون علامة مائية",
                    "icon": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/0d/b7/66/0db7662d-0b73-0f73-199f-7db92cf571ef/AppIcon-0-0-1x_U007emarketing-0-7-0-sRGB-85-220.png/512x512bb.jpg",
                    "installUrl": "#"
                },
                {
                    "name": "دلتا إكسترا (Delta)",
                    "desc": "محاكي ألعاب نينتندو وسگا",
                    "icon": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/91/9f/62/919f6261-f3b1-4d92-7108-95a0bc07e26d/AppIcon-0-0-1x_U007emarketing-0-7-0-sRGB-85-220.png/512x512bb.jpg",
                    "installUrl": "#"
                }
            ]
        };

        const container = document.getElementById('appContainer');
        data.apps.forEach(app => {
            container.innerHTML += `
                <div class="app-card">
                    <img src="${app.icon}" class="app-icon" alt="">
                    <div class="app-info">
                        <div class="app-name">${app.name}</div>
                        <div class="app-desc">${app.desc}</div>
                    </div>
                    <a href="${app.installUrl}" class="install-btn">تثبيت</a>
                </div>
            `;
        });
    </script>
</body>
</html>
